# PhotoHub の設定例。コピーして .env を作り、値を入れる（.env はコミットしない）

# DSM / Synology Photos
DSM_URL=https://nas.local:5001
DSM_USER=photohub
DSM_PASSWORD=

# PhotoHub API（Androidアプリからの接続用トークン）
PHOTOHUB_API_TOKEN=

# フォルダ
PHOTOHUB_ROOT=/volume1/photohub
PHOTO_LIBRARY_ROOT=/volume1/photo

# 通知（ntfy）
NTFY_URL=
NTFY_TOPIC=
