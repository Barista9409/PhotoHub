# PhotoHub settings. Copy to .env next to docker-compose.yml on the NAS and fill in.
# .env is git-ignored: never commit passwords or tokens.

# --- safety ---------------------------------------------------------------
# false = every job is a dry run (reports only). Set true only after you have
# checked the dry-run results of the first run on your real photos.
PHOTOHUB_APPLY=false

# --- container user (DSM user "photohub") ---------------------------------
PUID=1026
PGID=100

# --- family members ---------------------------------------------------------
# Family members log in to the app with their Synology (DSM) user name and password.
# PhotoHub creates their PhotoHub user on first login. Admins (may organise the shared space):
PHOTOHUB_ADMINS=reo
# Set false to allow only users you add with `photohub user add NAME`
PHOTOHUB_AUTO_USERS=true
# Addresses are detected automatically (LAN, and Tailscale if installed). Override only if wrong:
# PHOTOHUB_LAN_URL=http://192.168.1.10:8765
# PHOTOHUB_REMOTE_URL=http://100.64.0.10:8765

# --- DSM ------------------------------------------------------------------------
# Where DSM answers (default https://127.0.0.1:5001 = this NAS). Change if you moved the DSM port.
# DSM_URL=https://127.0.0.1:5001
# Synology Photos API (research §3, D1): keep false until `photohub synology probe` works
SYNOLOGY_API_ENABLED=false
DSM_USER=photohub
DSM_PASSWORD=
DSM_VERIFY_TLS=false

# --- notifications (ntfy) -----------------------------------------------------
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# --- schedule / thresholds ----------------------------------------------------
# date you booked the Takeout "every 2 months for 1 year" export (YYYY-MM-DD)
PHOTOHUB_TAKEOUT_SCHEDULE_START=
PHOTOHUB_GOOGLE_KEEP_MONTHS=12
PHOTOHUB_MIN_FREE_GB=200
PHOTOHUB_AMAZON_STALE_DAYS=7
# heavy jobs only in these local hours (empty = any time), e.g. 1-7
PHOTOHUB_WORK_HOURS=
PHOTOHUB_WORKERS=2
# extra folders to index, colon-separated container paths, e.g. /data/mobile
PHOTOHUB_SCAN_EXTRA=
