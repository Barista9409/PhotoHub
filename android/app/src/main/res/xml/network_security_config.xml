<?xml version="1.0" encoding="utf-8"?>
<!-- The NAS API is reached on the home LAN or through Tailscale (WireGuard-encrypted),
     both by plain HTTP to a private address; the API is never exposed to the internet. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
